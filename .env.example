DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_X_FORWARDED_PROTO=False
DJANGO_USE_X_FORWARDED_HOST=False
POSTGRES_DB=simpwatch
POSTGRES_USER=simpwatch
POSTGRES_PASSWORD=simpwatch
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://simpwatch:simpwatch@db:5432/simpwatch
CACHE_URL=redis://redis:6379/1
LEADERBOARD_CACHE_TTL_SECONDS=15
SIMP_DEFAULT_POINTS=1
SIMP_DEFAULT_COOLDOWN_SECONDS=0
TWITCH_BOT_USERNAME=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_ID=
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=
TWITCH_TOKEN_SCOPES=user:bot user:read:chat user:write:chat
TWITCH_TOKEN_REDIRECT_URI=
TWITCH_TOKEN_CALLBACK_TIMEOUT_SECONDS=300
# Twitch channels are now configured via Django admin (simpwatch > Twitch channels), not env vars.
TWITCH_WATCHDOG_TIMEOUT=300
TWITCH_DB_TIMEOUT=10
TWITCH_STATS_INTERVAL=300
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
BUGSINK_DSN=
